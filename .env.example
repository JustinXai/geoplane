# Database environment configuration (template — copy to .env.local and fill in).
# .env.local is gitignored and MUST NEVER be committed. Values here are placeholders only
# (CHANGE_ME) — never put a real credential in this file.
#
# THREE DATABASE ENVIRONMENT ROLES (ENVIRONMENT_CONFIGURATION_RECONCILIATION_V1).
# Verify a local setup with: npm run preflight:db-env
#
# 1) runtime — the local/staging runtime database. Real application data lives here.
#    Automated tests never TRUNCATE it and the provider canary never touches it.
GEO_DATABASE_URL=postgresql://geoplane_app:CHANGE_ME@localhost:5432/geoplane_local_runtime
#
# 2) test — the automated-test database. DB-backed tests TRUNCATE it freely, so it must be
#    throwaway and its database NAME must contain "test". Never point this at real data.
GEO_TEST_DATABASE_URL=postgresql://geoplane_app:CHANGE_ME@localhost:5432/geoplane_local_test
#
# 3) canary — an ISOLATED database dedicated to provider canary runs (its NAME must contain
#    "canary"). RULE: the canary database must NEVER point at the runtime or test databases
#    (compared by host+port+dbname), and the canary runner (scripts/provider/micro-canary.mjs)
#    reads ONLY this variable — it never falls back to GEO_TEST_DATABASE_URL / GEO_DATABASE_URL.
GEO_CANARY_DATABASE_URL=postgresql://geoplane_app:CHANGE_ME@localhost:5432/geoplane_local_canary

# Local closed-pilot safety posture. The local preflight requires an explicit false.
LOCAL_ONLY_MODE=TRUE
REMOTE_WRITE=FORBIDDEN
PROVIDER_RUNTIME_ENABLED=false
NEXT_PUBLIC_INDEPENDENT_DETECTION_PROTOTYPE_ENABLED=FALSE

# The managed local launcher binds only to 127.0.0.1 and enables its contained HTTP-cookie mode.
# Production/staging deployments remain Secure-cookie-only; do not reuse this posture off-loopback.
LOCAL_APP_HOST=127.0.0.1
LOCAL_SESSION_COOKIE_SECURE=false

# Generate distinct random values of at least 32 characters in .env.local. Never commit or log
# those values. CHANGE_ME placeholders intentionally fail the local preflight.
SESSION_SIGNING_KEY_CURRENT=CHANGE_ME
REVIEW_REFERENCE_KEY_CURRENT=CHANGE_ME

# Distinct sanitized local-account passwords. Values are stored only as scrypt digests in
# PostgreSQL. Keep the plaintext values only in .env.local / an out-of-band local secret store.
LOCAL_PLATFORM_ADMIN_PASSWORD=CHANGE_ME
LOCAL_AGENCY_OWNER_PASSWORD=CHANGE_ME
LOCAL_CLIENT_OWNER_PASSWORD=CHANGE_ME

# Optional; defaults to 3000 and always binds to 127.0.0.1.
LOCAL_APP_PORT=3000

# Must be outside the repository. Backup artifacts contain database data; protect this directory.
LOCAL_BACKUP_DIR=CHANGE_ME
