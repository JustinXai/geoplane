# Core runtime database configuration (template — copy to .env.local and fill in).
# .env.local is gitignored and MUST NEVER be committed.
#
# Runtime database (application):
GEO_DATABASE_URL=postgresql://geoplane_app:CHANGE_ME@localhost:5432/geoplane_runtime
# Throwaway test database (DB-backed tests TRUNCATE it freely — never point this at real data):
GEO_TEST_DATABASE_URL=postgresql://geoplane_app:CHANGE_ME@localhost:5432/geoplane_runtime_test
