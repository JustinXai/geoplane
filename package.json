    "@types/react-dom": "^19.2.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "next": "^16.2.10",
    "pdf-parse": "^1.1.4",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unpdf": "^1.6.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
