{
  "name": "geoplane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:web": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:contracts": "tsc -p tsconfig.build.json",
    "security-scan": "node scripts/security-scan.mjs",
    "repo:safety:preflight": "node scripts/repo-safety-preflight.mjs",
    "acceptance:ui-truth": "node scripts/acceptance/ui-truth-scan.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:test": "node scripts/db/migrate.mjs --test",
    "db:migrate:canary": "node scripts/db/migrate.mjs --canary",
    "preflight:db-env": "node scripts/preflight/database-environment.mjs",
    "preflight:version": "node scripts/preflight/version-alignment.mjs",
    "preflight:runtime-version": "node scripts/preflight/version-alignment.mjs --runtime",
    "local:configure": "node scripts/local/configure.mjs",
    "local:preflight": "node scripts/local/preflight.mjs",
    "local:start": "node scripts/local/start.mjs",
    "local:status": "node scripts/local/status.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "local:seed": "node scripts/local/seed-sanitized-pilot.mjs",
    "local:functional": "node scripts/local/functional-pilot.mjs",
    "local:backup": "node scripts/local/backup.mjs",
    "local:restore-verify": "node scripts/local/restore-verify.mjs",
    "probe:worker": "node scripts/domestic-probe-worker.mjs",
    "probe:deps": "npm install playwright && npx playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
